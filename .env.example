# Database (Supabase Transaction Pooler, port 6543)
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Auth.js (openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="https://llazypilot.com"

# Meta App (https://developers.facebook.com/apps)
META_APP_ID=""
META_APP_SECRET=""
META_WEBHOOK_VERIFY_TOKEN=""

# App URL (含 basePath)
NEXT_PUBLIC_APP_URL="https://llazypilot.com/pikora"

# 部署環境（正式環境設為 production，本機開發不設定）
# NEXT_PUBLIC_DEPLOYMENT_ENV=production

# Discord Webhook 錯誤通知（選填）
# 頻道設定 → 整合 → Webhook → 建立 Webhook → 複製網址
# DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/xxxxx/yyyyy"

# Prisma CLI 遷移用 (port 5432，僅本機)
# DIRECT_DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
